<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>GattDiscoveryProbe</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="TestProbe.Tests/**/*.cs" />
    <None Remove="TestProbe.Tests/**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Program.cs">
      <LogicalName>GattDiscoveryProbe.Source.Program.cs</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Analysis/*.cs">
      <LogicalName>GattDiscoveryProbe.Source.Analysis.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="GattDiscoveryProbe.csproj">
      <LogicalName>GattDiscoveryProbe.Source.GattDiscoveryProbe.csproj</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>

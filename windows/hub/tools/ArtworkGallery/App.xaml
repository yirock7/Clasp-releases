<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="ArtworkGallery.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- The product's real tokens (linked), which hold the GlassArt* brushes the artwork uses. -->
                <ResourceDictionary Source="ms-appx:///Design/GlassTokens.xaml" />
                <!-- The product's real control styles (linked): GlassToggleStyle, GlassSliderStyle and the rest. -->
                <ResourceDictionary Source="ms-appx:///Design/GlassStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>

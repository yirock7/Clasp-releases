<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact battery item for the tray flyout (Left / Right / Case).
    Unknown, stale, low and charging each add text (and a glyph), never colour alone.
    The whole tile is one UIA element named by BatteryItemViewModel.AutomationName.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.BatteryTile"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:AppleDeviceHub.App.Design"
    xmlns:views="using:AppleDeviceHub.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="Root" RowSpacing="4">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Low">
                    <VisualState.Setters>
                        <Setter Target="PercentText.Foreground" Value="{ThemeResource GlassWarningBrush}" />
                        <Setter Target="LevelBar.Foreground" Value="{ThemeResource GlassWarningBrush}" />
                        <Setter Target="StatusGlyph.Glyph" Value="&#xE7BA;" />
                        <Setter Target="StatusGlyph.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Stale">
                    <VisualState.Setters>
                        <Setter Target="PercentText.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                        <Setter Target="LevelBar.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                        <Setter Target="StatusGlyph.Glyph" Value="&#xE81C;" />
                        <Setter Target="StatusGlyph.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unknown">
                    <VisualState.Setters>
                        <Setter Target="PercentText.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                        <Setter Target="LevelBar.Visibility" Value="Collapsed" />
                        <Setter Target="UnknownBar.Visibility" Value="Visible" />
                        <Setter Target="StatusGlyph.Glyph" Value="&#xE9CE;" />
                        <Setter Target="StatusGlyph.Visibility" Value="Visible" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="4" AutomationProperties.AccessibilityView="Raw">
            <TextBlock Text="{x:Bind Item.Label, Mode=OneWay}"
                       Style="{StaticResource GlassCaptionTextStyle}"
                       FontWeight="SemiBold" />
            <FontIcon Glyph="&#xE945;"
                      FontSize="12"
                      VerticalAlignment="Center"
                      Foreground="{ThemeResource GlassSuccessBrush}"
                      Visibility="{x:Bind design:GlassBind.Visible(Item.IsCharging), Mode=OneWay}" />
        </StackPanel>

        <TextBlock x:Name="PercentText"
                   Grid.Row="1"
                   Text="{x:Bind Item.PercentText, Mode=OneWay}"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{ThemeResource GlassTextPrimaryBrush}"
                   AutomationProperties.AccessibilityView="Raw" />

        <Grid x:Name="BarHost" Grid.Row="2" Height="4" AutomationProperties.AccessibilityView="Raw">
            <ProgressBar x:Name="LevelBar"
                         Minimum="0"
                         Maximum="100"
                         Value="{x:Bind design:GlassBind.Percent(Item.Level01), Mode=OneWay}"
                         Foreground="{ThemeResource GlassBatteryFillBrush}"
                         Background="{ThemeResource GlassRingTrackBrush}"
                         MinHeight="4"
                         VerticalAlignment="Center"
                         AutomationProperties.AccessibilityView="Raw" />
            <!-- Unknown: an empty dashed track instead of a guessed level. -->
            <Line x:Name="UnknownBar"
                  X1="0" Y1="2" X2="0" Y2="2"
                  Stretch="None"
                  Stroke="{ThemeResource GlassTextSecondaryBrush}"
                  StrokeThickness="2"
                  StrokeDashArray="2,2"
                  Visibility="Collapsed" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" AutomationProperties.AccessibilityView="Raw">
            <FontIcon x:Name="StatusGlyph"
                      Glyph="&#xE946;"
                      FontSize="12"
                      VerticalAlignment="Center"
                      Visibility="Collapsed"
                      Foreground="{ThemeResource GlassTextSecondaryBrush}" />
            <TextBlock Text="{x:Bind views:BatteryTile.StatusLine(Item.StatusText, Item.IsLow), Mode=OneWay}"
                       Style="{StaticResource GlassCaptionTextStyle}"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap" />
        </StackPanel>
    </Grid>
</UserControl>

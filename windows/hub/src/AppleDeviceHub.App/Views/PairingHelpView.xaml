<?xml version="1.0" encoding="utf-8"?>
<!--
    "How to pair your AirPods": a collapsible help block shared by the welcome guide (page 2) and
    Settings > AirPods, so the two never drift apart. The steps come from Core's PairingInstructions.
    Keyboard: the Expander opens with Space or Enter; the model picker is a normal ComboBox.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.PairingHelpView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AppleDeviceHub.App.Views"
    xmlns:ble="using:AppleDeviceHub.Core.Ble">

    <Expander x:Name="HelpExpander" x:Uid="PairingHelpExpander"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Stretch"
              Background="Transparent"
              BorderThickness="0"
              Padding="0,8,0,0"
              Expanding="OnExpanding"
              Collapsed="OnCollapsed">
        <StackPanel Spacing="{StaticResource GlassSpace12}">
            <ComboBox x:Name="ModelPicker" x:Uid="PairingHelpModelPicker"
                      HorizontalAlignment="Stretch"
                      SelectionChanged="OnModelSelected">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="ble:PairingGuide">
                        <TextBlock Text="{x:Bind Label}" TextWrapping="WrapWholeWords" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <!-- Small looping animation of the step; named for screen readers by code. Static for fallback guides. Created in code so a failure to build it can never take the help down. -->
            <Border x:Name="IllustrationHost" HorizontalAlignment="Center" />

            <TextBlock x:Name="GuideTitle" Style="{StaticResource GlassLabelTextStyle}"
                       TextWrapping="WrapWholeWords"
                       AutomationProperties.HeadingLevel="Level3" />

            <!-- An ItemsControl is exposed to screen readers as a list; each row reads as "1. text". -->
            <ItemsControl x:Name="StepList" IsTabStop="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="views:PairingStepItem">
                        <Grid ColumnSpacing="10" Margin="0,0,0,6" AutomationProperties.Name="{x:Bind Spoken}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{x:Bind Number}" Style="{StaticResource GlassLabelTextStyle}"
                                       AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Text}" Style="{StaticResource GlassBodyTextStyle}"
                                       TextWrapping="WrapWholeWords" AutomationProperties.AccessibilityView="Raw" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Expander>
</UserControl>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Battery ring for the case card. Known: a determinate arc (drawn in code) over a track.
    Unknown: an empty dashed ring and "—". Charging adds a bolt glyph; stale/low add text.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.BatteryRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:AppleDeviceHub.App.Design"
    xmlns:views="using:AppleDeviceHub.App.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <StackPanel x:Name="Root" Spacing="4" HorizontalAlignment="Center">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="LevelStates">
                <VisualState x:Name="Normal" />
                <VisualState x:Name="Low">
                    <VisualState.Setters>
                        <Setter Target="Arc.Stroke" Value="{ThemeResource GlassWarningBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Stale">
                    <VisualState.Setters>
                        <Setter Target="Arc.Stroke" Value="{ThemeResource GlassTextSecondaryBrush}" />
                        <Setter Target="PercentText.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
                <VisualState x:Name="Unknown">
                    <VisualState.Setters>
                        <Setter Target="Track.Visibility" Value="Collapsed" />
                        <Setter Target="Arc.Visibility" Value="Collapsed" />
                        <Setter Target="UnknownRing.Visibility" Value="Visible" />
                        <Setter Target="PercentText.Foreground" Value="{ThemeResource GlassTextSecondaryBrush}" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid Width="64" Height="64" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw">
            <Ellipse x:Name="Track"
                     Stroke="{ThemeResource GlassRingTrackBrush}"
                     StrokeThickness="5"
                     Margin="0" />
            <Ellipse x:Name="UnknownRing"
                     Stroke="{ThemeResource GlassTextSecondaryBrush}"
                     StrokeThickness="2"
                     StrokeDashArray="2,3"
                     Margin="2"
                     Visibility="Collapsed" />
            <!-- Data is a PathGeometry built in code (BatteryRing.xaml.cs). -->
            <Path x:Name="Arc"
                  Stroke="{ThemeResource GlassBatteryFillBrush}"
                  StrokeThickness="5"
                  StrokeStartLineCap="Round"
                  StrokeEndLineCap="Round" />
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="0">
                <FontIcon Glyph="&#xE945;"
                          FontSize="11"
                          HorizontalAlignment="Center"
                          Foreground="{ThemeResource GlassSuccessBrush}"
                          Visibility="{x:Bind design:GlassBind.Visible(Item.IsCharging), Mode=OneWay}" />
                <TextBlock x:Name="PercentText"
                           Text="{x:Bind Item.PercentText, Mode=OneWay}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{x:Bind Item.Label, Mode=OneWay}"
                   Style="{StaticResource GlassLabelTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   AutomationProperties.AccessibilityView="Raw" />
        <TextBlock Text="{x:Bind views:BatteryTile.StatusLine(Item.StatusText, Item.IsLow), Mode=OneWay}"
                   Style="{StaticResource GlassCaptionTextStyle}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   MaxWidth="96"
                   AutomationProperties.AccessibilityView="Raw" />
    </StackPanel>
</UserControl>

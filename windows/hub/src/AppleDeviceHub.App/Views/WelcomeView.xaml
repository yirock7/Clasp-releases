<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome guide (host: WelcomeWindow, ~480 x 640 DIP, same clear glass as Settings).
    Four short pages stacked in one cell; code shows one at a time (slide, or a crossfade under reduced motion).
    Page 1 what Clasp does, page 2 choose or pair your AirPods, page 3 where the tray icon is plus two toggles,
    page 4 quick settings (the common connection and battery choices).
    Buttons: Skip (small link), Back, Next / Done. The dots are decoration; the step is announced from code.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.WelcomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:design="using:AppleDeviceHub.App.Design"
    xmlns:views="using:AppleDeviceHub.App.Views"
    xmlns:connection="using:AppleDeviceHub.Core.Connection"
    FontWeight="Medium"
    Background="Transparent"
    KeyDown="OnViewKeyDown">

    <Grid>
    <!-- Reduced transparency: an opaque page behind the (also opaque) surfaces. -->
    <Border design:GlassFallback.ShowWhenOpaque="True"
            Background="{ThemeResource GlassOpaqueFillBrush}"
            Visibility="Collapsed" />
    <!-- Top inset clears the caption buttons (the window extends content into the title bar). -->
    <Grid Padding="20,44,20,20" RowSpacing="{StaticResource GlassSpace16}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <design:GlassSurface Style="{StaticResource GlassReadableSurfaceStyle}" Padding="24,20,24,20">
            <!-- 8 DIP gutter each side (margin out, padding back in): buttons on the content edge keep room for the hover lift and focus ring instead of being clipped by the scroller. -->
            <ScrollViewer x:Name="PageScroller" Margin="-8,0,-8,0" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" SizeChanged="OnPageScrollerSizeChanged">
            <Grid x:Name="PageHost" Padding="8,0,8,0">

                <!-- ===== Page 1: Welcome to Clasp ===== -->
                <StackPanel x:Name="Page1" Spacing="{StaticResource GlassSpace12}" VerticalAlignment="Center">
                    <views:ModelArtwork x:Name="HeroArt" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="Title1"
                               Style="{StaticResource GlassTitleTextStyle}" FontSize="26"
                               TextAlignment="Center" TextWrapping="WrapWholeWords"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Uid="WelcomePage1Body"
                               Style="{StaticResource GlassBodyTextStyle}"
                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                               TextAlignment="Center" TextWrapping="WrapWholeWords" />
                </StackPanel>

                <!-- ===== Page 2: Choose your AirPods ===== -->
                <StackPanel x:Name="Page2" Spacing="{StaticResource GlassSpace12}" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="Title2"
                               Style="{StaticResource GlassTitleTextStyle}" FontSize="26"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Name="Page2Intro" x:Uid="WelcomePage2Intro"
                               Style="{StaticResource GlassBodyTextStyle}"
                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />

                    <!-- Cycles through the supported shapes while nothing is found, then settles on the device. -->
                    <views:WaitingArtwork x:Name="HeroWaiting" HorizontalAlignment="Center" />
                    <TextBlock x:Name="WaitingStatus"
                               Style="{StaticResource GlassLabelTextStyle}" TextAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.LiveSetting="Polite" />

                    <!-- Ready to pair: filled by code while page 2 shows (hidden when there is no discovery). -->
                    <StackPanel x:Name="PairPanel" Spacing="{StaticResource GlassSpace8}" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Spacing="{StaticResource GlassSpace8}">
                            <ProgressRing x:Name="PairRing" Width="16" Height="16" IsActive="False" VerticalAlignment="Center"
                                          AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock x:Name="PairStatus" Style="{StaticResource GlassLabelTextStyle}"
                                       TextWrapping="WrapWholeWords" VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite" />
                        </StackPanel>
                        <StackPanel x:Name="PairList" Spacing="{StaticResource GlassSpace4}" />
                    </StackPanel>

                    <!-- Shown when Windows lists at least one paired device. -->
                    <StackPanel x:Name="PickerPanel" Spacing="{StaticResource GlassSpace8}">
                        <ComboBox x:Name="PairedDevicePicker" x:Uid="WelcomePairedPicker"
                                  HorizontalAlignment="Stretch"
                                  SelectionChanged="OnPairedDeviceSelected">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="connection:ConnectionDevice">
                                    <TextBlock Text="{x:Bind Name}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="PickerStatus" Style="{StaticResource GlassLabelTextStyle}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- Shown when nothing is paired yet. -->
                    <StackPanel x:Name="EmptyPanel" Spacing="{StaticResource GlassSpace4}" Visibility="Collapsed">
                        <TextBlock x:Name="EmptyTitle"
                                   Style="{StaticResource GlassSectionTitleTextStyle}"
                                   AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock x:Name="EmptyDetail"
                                   Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <!-- Opens by itself when nothing is paired yet. -->
                    <views:PairingHelpView x:Name="PairingHelp" />

                    <StackPanel Orientation="Horizontal" Spacing="{StaticResource GlassSpace8}">
                        <design:GlassButton x:Name="OpenBluetoothButton"
                                            Visibility="Collapsed"
                                            Click="OnOpenBluetoothSettingsClick" />
                        <design:GlassButton x:Name="RefreshButton" x:Uid="WelcomeRefreshButton"
                                            Click="OnRefreshClick" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== Page 3: Find Clasp in the tray ===== -->
                <StackPanel x:Name="Page3" Spacing="{StaticResource GlassSpace12}" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="Title3"
                               Style="{StaticResource GlassTitleTextStyle}" FontSize="26"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Uid="WelcomePage3Body"
                               Style="{StaticResource GlassBodyTextStyle}"
                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />

                    <!-- Illustration: the hidden-icons popup holds Clasp's logo; an arrow drops it into an empty spot on the
                         taskbar, between the ^ chevron and the clock. Drawn from shapes plus the real logo (set in code). -->
                    <Viewbox x:Uid="WelcomeTrayIllustration" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" MaxHeight="104"
                             AutomationProperties.AccessibilityView="Content">
                    <Canvas Width="300" Height="100">
                        <!-- Taskbar strip -->
                        <Rectangle Canvas.Left="0" Canvas.Top="64" Width="300" Height="34" RadiusX="9" RadiusY="9"
                                   Fill="{ThemeResource GlassControlFillBrush}" Stroke="{ThemeResource GlassControlEdgeBrush}" StrokeThickness="1" />
                        <!-- Left: a few app icons -->
                        <Rectangle Canvas.Left="14" Canvas.Top="73" Width="16" Height="16" RadiusX="4" RadiusY="4" Fill="{ThemeResource GlassTrackBrush}" />
                        <Rectangle Canvas.Left="38" Canvas.Top="73" Width="16" Height="16" RadiusX="4" RadiusY="4" Fill="{ThemeResource GlassTrackBrush}" />
                        <Rectangle Canvas.Left="62" Canvas.Top="73" Width="16" Height="16" RadiusX="4" RadiusY="4" Fill="{ThemeResource GlassTrackBrush}" />
                        <!-- Tray: the ^ chevron (highlighted, it opens the popup), an empty spot for Clasp, a status icon, the clock -->
                        <Rectangle Canvas.Left="150" Canvas.Top="70" Width="22" Height="22" RadiusX="6" RadiusY="6"
                                   Fill="{ThemeResource GlassSelectedFillBrush}" Stroke="{ThemeResource GlassSelectedEdgeBrush}" StrokeThickness="1" />
                        <Path Canvas.Left="155" Canvas.Top="78" Data="M 0,6 L 6,0 L 12,6" Stroke="{ThemeResource GlassTextPrimaryBrush}"
                              StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        <Rectangle Canvas.Left="180" Canvas.Top="69" Width="24" Height="24" RadiusX="7" RadiusY="7"
                                   Stroke="{ThemeResource GlassAccentFillBrush}" StrokeThickness="1.5" StrokeDashArray="3 3" />
                        <views:ClaspGlyph x:Name="GhostLogo" Canvas.Left="183" Canvas.Top="72" Width="18" Height="18" Opacity="0.4" />
                        <Ellipse Canvas.Left="214" Canvas.Top="75" Width="12" Height="12" Fill="{ThemeResource GlassTextSecondaryBrush}" />
                        <Rectangle Canvas.Left="244" Canvas.Top="73" Width="40" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource GlassTextSecondaryBrush}" />
                        <Rectangle Canvas.Left="250" Canvas.Top="83" Width="28" Height="5" RadiusX="2.5" RadiusY="2.5" Fill="{ThemeResource GlassTrackBrush}" />

                        <!-- The hidden-icons popup above the chevron: two grey placeholders and Clasp -->
                        <Rectangle Canvas.Left="108" Canvas.Top="4" Width="106" Height="40" RadiusX="10" RadiusY="10"
                                   Fill="{ThemeResource GlassReadableFillBrush}" Stroke="{ThemeResource GlassControlEdgeBrush}" StrokeThickness="1" />
                        <Ellipse Canvas.Left="120" Canvas.Top="16" Width="16" Height="16" Fill="{ThemeResource GlassTrackBrush}" />
                        <Ellipse Canvas.Left="148" Canvas.Top="16" Width="16" Height="16" Fill="{ThemeResource GlassTrackBrush}" />
                        <views:ClaspGlyph x:Name="PopupLogo" Canvas.Left="180" Canvas.Top="12" Width="24" Height="24" />

                        <!-- Dashed arrow: straight down from Clasp's icon to the empty spot, clear of the chevron -->
                        <Path Data="M 192,47 L 192,60" Stroke="{ThemeResource GlassAccentFillBrush}" StrokeThickness="2"
                              StrokeDashArray="2.5 2.5" StrokeStartLineCap="Round" />
                        <Path Data="M 187.5,57 L 192,63 L 196.5,57" Stroke="{ThemeResource GlassAccentFillBrush}" StrokeThickness="2"
                              StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    </Canvas>
                    </Viewbox>

                    <TextBlock x:Uid="WelcomeTrayTip"
                               Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />

                    <Rectangle Height="1" Fill="{ThemeResource GlassDividerBrush}" />

                    <!-- Same two settings as Settings: Startup lives in the registry, Nearby detection in HubSettings. -->
                    <Grid ColumnSpacing="{StaticResource GlassSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="WelcomeStartupLabel" Style="{StaticResource GlassLabelTextStyle}" />
                            <TextBlock x:Uid="WelcomeStartupCaption"
                                       Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ToggleSwitch x:Name="RunOnStartupToggle" x:Uid="WelcomeStartupToggle" Grid.Column="1"
                                      Style="{StaticResource GlassRowToggleStyle}"
                                      Toggled="OnRunOnStartupToggled" />
                    </Grid>
                    <TextBlock x:Name="RunOnStartupStatus" Visibility="Collapsed"
                               Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords"
                               AutomationProperties.LiveSetting="Polite" />

                    <Grid ColumnSpacing="{StaticResource GlassSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="WelcomeNearbyLabel" Style="{StaticResource GlassLabelTextStyle}" />
                            <TextBlock x:Name="NearbyHelp"
                                       Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ToggleSwitch x:Name="NearbyToggle" x:Uid="WelcomeNearbyToggle" Grid.Column="1"
                                      Style="{StaticResource GlassRowToggleStyle}"
                                      Toggled="OnNearbyToggled" />
                    </Grid>
                </StackPanel>

                <!-- ===== Page 4: Quick settings ===== -->
                <StackPanel x:Name="Page4" Spacing="{StaticResource GlassSpace12}" Visibility="Collapsed" VerticalAlignment="Center">
                    <TextBlock x:Name="Title4"
                               Style="{StaticResource GlassTitleTextStyle}" FontSize="26"
                               TextWrapping="WrapWholeWords"
                               AutomationProperties.HeadingLevel="Level1" />
                    <TextBlock x:Uid="WelcomePage4Body"
                               Style="{StaticResource GlassBodyTextStyle}"
                               Foreground="{ThemeResource GlassTextSecondaryBrush}"
                               TextWrapping="WrapWholeWords" />

                    <StackPanel Spacing="2">
                        <ComboBox x:Name="LowBatteryBox" x:Uid="WelcomeLowBatteryBox" HorizontalAlignment="Stretch"
                                  SelectionChanged="OnLowBatteryChanged">
                            <ComboBoxItem x:Uid="WelcomeLowBatteryOff" />
                            <ComboBoxItem x:Uid="WelcomeLowBatteryAt10" />
                            <ComboBoxItem x:Uid="WelcomeLowBatteryAt20" />
                            <ComboBoxItem x:Uid="WelcomeLowBatteryAt30" />
                        </ComboBox>
                        <TextBlock x:Uid="WelcomeLowBatteryCaption"
                                   Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                    </StackPanel>

                    <Grid ColumnSpacing="{StaticResource GlassSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="WelcomeAutoConnectLabel" Style="{StaticResource GlassLabelTextStyle}" />
                            <TextBlock x:Name="AutoConnectHelp"
                                       Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoConnectToggle" x:Uid="WelcomeAutoConnectToggle" Grid.Column="1"
                                      Style="{StaticResource GlassRowToggleStyle}"
                                      Toggled="OnQuickToggled" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource GlassSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="WelcomeSwitchOutputLabel" Style="{StaticResource GlassLabelTextStyle}" />
                            <TextBlock x:Uid="WelcomeSwitchOutputCaption"
                                       Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ToggleSwitch x:Name="SwitchOutputToggle" x:Uid="WelcomeSwitchOutputToggle" Grid.Column="1"
                                      Style="{StaticResource GlassRowToggleStyle}"
                                      Toggled="OnQuickToggled" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource GlassSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="WelcomeAutoPlayLabel" Style="{StaticResource GlassLabelTextStyle}" />
                            <TextBlock x:Uid="WelcomeAutoPlayCaption"
                                       Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoPlayToggle" x:Uid="WelcomeAutoPlayToggle" Grid.Column="1"
                                      Style="{StaticResource GlassRowToggleStyle}"
                                      Toggled="OnQuickToggled" />
                    </Grid>
                    <Grid ColumnSpacing="{StaticResource GlassSpace12}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock x:Uid="WelcomeAutoPauseLabel" Style="{StaticResource GlassLabelTextStyle}" />
                            <TextBlock x:Uid="WelcomeAutoPauseCaption"
                                       Style="{StaticResource GlassCaptionTextStyle}" TextWrapping="WrapWholeWords" />
                        </StackPanel>
                        <ToggleSwitch x:Name="AutoPauseToggle" x:Uid="WelcomeAutoPauseToggle" Grid.Column="1"
                                      Style="{StaticResource GlassRowToggleStyle}"
                                      Toggled="OnQuickToggled" />
                    </Grid>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </design:GlassSurface>

        <!-- ===== Footer: Skip | dots | Back, Next/Done ===== -->
        <Grid Grid.Row="1" ColumnSpacing="{StaticResource GlassSpace8}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <design:GlassButton x:Name="SkipButton" x:Uid="WelcomeSkipButton"
                                IsFlat="True" Padding="10,4,10,4" MinHeight="32"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Click="OnSkipClick" />

            <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" Spacing="8"
                        VerticalAlignment="Center">
                <Grid Width="8" Height="8">
                    <Ellipse Fill="{ThemeResource GlassTextDisabledBrush}" />
                    <Ellipse x:Name="Dot1" Fill="{ThemeResource GlassAccentFillBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Width="8" Height="8">
                    <Ellipse Fill="{ThemeResource GlassTextDisabledBrush}" />
                    <Ellipse x:Name="Dot2" Fill="{ThemeResource GlassAccentFillBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Width="8" Height="8">
                    <Ellipse Fill="{ThemeResource GlassTextDisabledBrush}" />
                    <Ellipse x:Name="Dot3" Fill="{ThemeResource GlassAccentFillBrush}" Visibility="Collapsed" />
                </Grid>
                <Grid Width="8" Height="8">
                    <Ellipse Fill="{ThemeResource GlassTextDisabledBrush}" />
                    <Ellipse x:Name="Dot4" Fill="{ThemeResource GlassAccentFillBrush}" Visibility="Collapsed" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="{StaticResource GlassSpace8}" HorizontalAlignment="Right">
                <design:GlassButton x:Name="BackButton" x:Uid="WelcomeBackButton" MinWidth="72" Visibility="Collapsed"
                                    Click="OnBackClick" />
                <design:GlassButton x:Name="NextButton" MinWidth="84"
                                    Style="{StaticResource GlassAccentButtonStyle}"
                                    Click="OnNextClick" />
            </StackPanel>
        </Grid>
    </Grid>
    </Grid>
</UserControl>

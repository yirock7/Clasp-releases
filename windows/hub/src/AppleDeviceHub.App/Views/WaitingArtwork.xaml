<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome page 2 hero. While no device is found it slowly cycles through the supported shapes (layers are added by
    code, one ModelArtwork per shape, crossfaded by composition keyframes). When a device is found it settles on that
    device's drawing with a check badge. Status text and the live region belong to the host page.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.WaitingArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AppleDeviceHub.App.Views"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" MaxHeight="112">
        <Grid Width="200" Height="150">
            <Grid x:Name="CycleLayers" Width="200" Height="150" />
            <views:ModelArtwork x:Name="FoundArt" Visibility="Collapsed" />
            <!-- Check badge, bottom right of the drawing. -->
            <Grid x:Name="Badge" Width="30" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,24,16" Visibility="Collapsed">
                <Ellipse Fill="{ThemeResource GlassAccentFillBrush}" />
                <Path Data="M 9,15.5 L 13.5,20 L 21,10.5" Stroke="{ThemeResource GlassOnAccentBrush}" StrokeThickness="2.6"
                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>

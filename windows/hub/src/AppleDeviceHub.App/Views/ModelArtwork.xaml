<?xml version="1.0" encoding="utf-8"?>
<!--
    ORIGINAL provisional artwork for models without a charging case, plus the case drawing itself.
    One 200x150 stage (the same as CaseArtwork) holds a CaseArtwork and one drawing per no-case group;
    ModelArtwork.xaml.cs shows only the current group's. Every drawing is simple geometry from
    primitive shapes and closed Paths (no photos, tracing, logos or letters), filled and outlined with
    the existing GlassArt* theme brushes so Light, Dark and High Contrast all work. Front view, symmetric.
    The no-case drawings fade by composition opacity on their Canvas; do not set XAML Opacity on them.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.ModelArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AppleDeviceHub.App.Views"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <Grid x:Name="Stage" Width="200" Height="150" HorizontalAlignment="Center">
        <views:CaseArtwork x:Name="CaseDrawing" />

        <!-- AirPods Max style: wide flat canopy band with an inset strip, thin stems, tall rounded-rectangle cups with an inner cushion. -->
        <Canvas x:Name="MaxArt" Width="200" Height="150" Visibility="Collapsed">
            <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10" Fill="{ThemeResource GlassArtShadowBrush}" />
            <Path Data="M 46,64 L 46,46 C 46,30 58,20 76,20 L 124,20 C 142,20 154,30 154,46 L 154,64 L 150,64 L 150,48 C 150,38 142,32 126,32 L 74,32 C 58,32 50,38 50,48 L 50,64 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="78" Canvas.Top="23" Width="44" Height="6" RadiusX="3" RadiusY="3" Fill="{ThemeResource GlassArtDetailBrush}" />
            <Rectangle Canvas.Left="26" Canvas.Top="62" Width="44" Height="68" RadiusX="18" RadiusY="18" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="130" Canvas.Top="62" Width="44" Height="68" RadiusX="18" RadiusY="18" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="34" Canvas.Top="72" Width="28" Height="48" RadiusX="12" RadiusY="12" Fill="{ThemeResource GlassArtLidInnerBrush}" Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="138" Canvas.Top="72" Width="28" Height="48" RadiusX="12" RadiusY="12" Fill="{ThemeResource GlassArtLidInnerBrush}" Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
        </Canvas>

        <!-- Over-ear: slim round arch with a slider notch each side, large ovals, cushion oval and a plain centre disc. -->
        <Canvas x:Name="OverEarArt" Width="200" Height="150" Visibility="Collapsed">
            <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10" Fill="{ThemeResource GlassArtShadowBrush}" />
            <Path Data="M 46,62 A 54,44 0 0 1 154,62 L 149,62 A 49,39 0 0 0 51,62 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="45" Canvas.Top="46" Width="10" Height="12" RadiusX="3" RadiusY="3" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="145" Canvas.Top="46" Width="10" Height="12" RadiusX="3" RadiusY="3" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="25" Canvas.Top="58" Width="50" Height="72" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="125" Canvas.Top="58" Width="50" Height="72" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="33" Canvas.Top="66" Width="34" Height="56" Fill="{ThemeResource GlassArtLidInnerBrush}" Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="133" Canvas.Top="66" Width="34" Height="56" Fill="{ThemeResource GlassArtLidInnerBrush}" Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="41" Canvas.Top="85" Width="18" Height="18" Fill="{ThemeResource GlassArtDetailBrush}" />
            <Ellipse Canvas.Left="141" Canvas.Top="85" Width="18" Height="18" Fill="{ThemeResource GlassArtDetailBrush}" />
        </Canvas>

        <!-- On-ear: smaller slim arch that sits lower, small circles with a thick cushion ring. -->
        <Canvas x:Name="OnEarArt" Width="200" Height="150" Visibility="Collapsed">
            <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10" Fill="{ThemeResource GlassArtShadowBrush}" />
            <Path Data="M 52,82 A 48,46 0 0 1 148,82 L 143,82 A 43,41 0 0 0 57,82 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="30" Canvas.Top="80" Width="44" Height="48" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="126" Canvas.Top="80" Width="44" Height="48" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="35" Canvas.Top="85" Width="34" Height="38" Stroke="{ThemeResource GlassArtDetailBrush}" StrokeThickness="7" />
            <Ellipse Canvas.Left="131" Canvas.Top="85" Width="34" Height="38" Stroke="{ThemeResource GlassArtDetailBrush}" StrokeThickness="7" />
        </Canvas>

        <!-- Corded ear hooks: two mirrored bud-and-hook shapes joined by a slack cord below them. -->
        <Canvas x:Name="CordedArt" Width="200" Height="150" Visibility="Collapsed">
            <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10" Fill="{ThemeResource GlassArtShadowBrush}" />
            <Path Data="M 50,112 C 56,142 144,142 150,112 L 147,112 C 142,137 58,137 53,112 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Path Data="M 40,92 C 24,70 36,34 66,30 C 80,28 90,36 92,46 L 85,48 C 82,42 76,38 66,38 C 44,40 36,68 48,88 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Path Data="M 160,92 C 176,70 164,34 134,30 C 120,28 110,36 108,46 L 115,48 C 118,42 124,38 134,38 C 156,40 164,68 152,88 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="35" Canvas.Top="83" Width="34" Height="30" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="131" Canvas.Top="83" Width="34" Height="30" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="47" Canvas.Top="92" Width="10" Height="8" Fill="{ThemeResource GlassArtDetailBrush}" />
            <Ellipse Canvas.Left="143" Canvas.Top="92" Width="10" Height="8" Fill="{ThemeResource GlassArtDetailBrush}" />
        </Canvas>

        <!-- Neckband: an open-topped horseshoe collar seen from the front with thick pods at both ends; a small bud hangs on a thin cable outside it at the lower left and lower right. -->
        <Canvas x:Name="NeckbandArt" Width="200" Height="150" Visibility="Collapsed">
            <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10" Fill="{ThemeResource GlassArtShadowBrush}" />
            <Path Data="M 52,50 C 40,66 28,80 32,98 L 35,98 C 31,82 43,68 56,52 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Path Data="M 148,50 C 160,66 172,80 168,98 L 165,98 C 169,82 157,68 144,52 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Path Data="M 54,34 C 54,120 146,120 146,34 L 132,34 C 132,100 68,100 68,34 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="50" Canvas.Top="22" Width="20" Height="32" RadiusX="9" RadiusY="9" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="130" Canvas.Top="22" Width="20" Height="32" RadiusX="9" RadiusY="9" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="22" Canvas.Top="98" Width="22" Height="22" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="156" Canvas.Top="98" Width="22" Height="22" Fill="{ThemeResource GlassArtCaseFillBrush}"
                     Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Ellipse Canvas.Left="29" Canvas.Top="105" Width="8" Height="6" Fill="{ThemeResource GlassArtDetailBrush}" />
            <Ellipse Canvas.Left="163" Canvas.Top="105" Width="8" Height="6" Fill="{ThemeResource GlassArtDetailBrush}" />
        </Canvas>

        <!-- Generic: deliberately plain arch band and medium plain rounded cups. -->
        <Canvas x:Name="GenericArt" Width="200" Height="150" Visibility="Collapsed">
            <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10" Fill="{ThemeResource GlassArtShadowBrush}" />
            <Path Data="M 46,70 A 54,48 0 0 1 154,70 L 147,70 A 47,41 0 0 0 53,70 Z" Fill="{ThemeResource GlassArtCaseFillBrush}"
                  Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="30" Canvas.Top="66" Width="40" Height="56" RadiusX="14" RadiusY="14" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            <Rectangle Canvas.Left="130" Canvas.Top="66" Width="40" Height="56" RadiusX="14" RadiusY="14" Fill="{ThemeResource GlassArtCaseFillBrush}"
                       Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
        </Canvas>

        <!-- Charging badge, owned by ModelArtwork for every drawing; faded by composition opacity (do not set XAML Opacity on it). -->
        <Border x:Name="ChargingBadge" Width="22" Height="22" CornerRadius="11"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,6,6"
                Background="{ThemeResource GlassChipNeutralFillBrush}"
                BorderBrush="{ThemeResource GlassChipEdgeBrush}" BorderThickness="1"
                IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
            <FontIcon Glyph="&#xE945;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Foreground="{ThemeResource GlassSuccessBrush}" />
        </Border>
    </Grid>
</UserControl>

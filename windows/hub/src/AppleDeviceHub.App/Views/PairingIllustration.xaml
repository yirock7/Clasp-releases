<?xml version="1.0" encoding="utf-8"?>
<!--
    The small looping animation for one pairing guide: the device artwork, an overlay marking the control (a ring that
    fills while it is held, tap ripples with a count, a dashed ring and arrow for a button on the back, a flash for the
    status light) and a caption chip below that says in words what to do. Motion is composition keyframes
    (PairingIllustration.xaml.cs). Overlay elements are hidden and positioned by code; do not set XAML Opacity or
    RenderTransform on them. The chip is ordinary text and is the one thing screen readers read.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.PairingIllustration"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:AppleDeviceHub.App.Views"
    IsTabStop="False">

    <StackPanel Spacing="8" HorizontalAlignment="Center">
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Center" MaxHeight="124">
            <Grid Width="200" Height="150">
                <views:ModelArtwork x:Name="Art" />
                <Canvas x:Name="Overlay" Width="200" Height="150" IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw">
                    <!-- Tap ripples (double-tap guides). -->
                    <Ellipse x:Name="RippleA" Width="40" Height="40" Stroke="{ThemeResource GlassAccentBrush}" StrokeThickness="2.5" />
                    <Ellipse x:Name="RippleB" Width="40" Height="40" Stroke="{ThemeResource GlassAccentBrush}" StrokeThickness="2.5" />
                    <!-- "x2" next to the ripples. -->
                    <Border x:Name="TapBadge" Background="{ThemeResource GlassAccentBrush}" CornerRadius="8" Padding="5,1">
                        <TextBlock Text="2&#215;" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <!-- "back" tag beside a button on the back of the case. -->
                    <Border x:Name="BackBadge" Background="{ThemeResource GlassAccentBrush}" CornerRadius="8" Padding="6,1">
                        <TextBlock Text="on the back" FontSize="12" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <!-- Curved arrow that goes "around the back" to a button the front view cannot show. -->
                    <Path x:Name="BackArrowHalo" Stroke="#FFFFFFFF" StrokeThickness="5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <Path x:Name="BackArrow" Stroke="{ThemeResource GlassAccentBrush}" StrokeThickness="2.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <!-- Marker on the control: a white halo (so it shows on dark and light drawings), the ring (dashed for a back button),
                         and a ring that fills while the button is held (a composition shape, see code). Under Reduce motion the ring simply stays. -->
                    <Grid x:Name="Marker" Width="36" Height="36">
                        <Ellipse x:Name="HoldHalo" Width="30" Height="30" Stroke="#FFFFFFFF" StrokeThickness="6" />
                        <Ellipse x:Name="HoldRing" Width="30" Height="30" Stroke="{ThemeResource GlassAccentBrush}" StrokeThickness="2.5" />
                        <Border x:Name="ProgressHost" Width="36" Height="36" />
                    </Grid>
                    <!-- The status light flashing white. -->
                    <Ellipse x:Name="Flash" Width="16" Height="16" Fill="#FFFFFFFF" Stroke="{ThemeResource GlassAccentBrush}" StrokeThickness="1.5" />
                </Canvas>
            </Grid>
        </Viewbox>

        <!-- The caption chip: what to do and where, then what the light does. Same words a screen reader gets. -->
        <Border x:Name="Chip" HorizontalAlignment="Center" MaxWidth="340" Padding="12,6" CornerRadius="{StaticResource GlassChipRadius}"
                Background="{ThemeResource GlassChipNeutralFillBrush}" BorderBrush="{ThemeResource GlassChipEdgeBrush}" BorderThickness="1"
                Visibility="Collapsed">
            <StackPanel Spacing="0" AutomationProperties.AccessibilityView="Raw">
                <TextBlock x:Name="ChipAction" FontSize="13" FontWeight="SemiBold" TextAlignment="Center" TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource GlassTextPrimaryBrush}" />
                <TextBlock x:Name="ChipLight" FontSize="12" TextAlignment="Center" TextWrapping="WrapWholeWords"
                           Foreground="{ThemeResource GlassTextSecondaryBrush}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>

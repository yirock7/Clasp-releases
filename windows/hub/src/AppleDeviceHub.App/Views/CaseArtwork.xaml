<?xml version="1.0" encoding="utf-8"?>
<!--
    ORIGINAL provisional case artwork, drawn with XAML shapes (no upstream PNGs).
    Front view: rounded case body, a separate lid hinged at the top of the body, and two
    simple earbud shapes sitting behind the body/lid. Draw order: shadow, buds, body, lid.
    The lid and buds are animated with composition (CaseArtwork.xaml.cs); do not set XAML
    Opacity/RenderTransform on Lid, LidInner or Buds.
-->
<UserControl
    x:Class="AppleDeviceHub.App.Views.CaseArtwork"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    AutomationProperties.AccessibilityView="Raw"
    IsTabStop="False">

    <Canvas x:Name="Stage" Width="200" Height="150" HorizontalAlignment="Center">

        <!-- Soft contact shadow. -->
        <Ellipse Canvas.Left="30" Canvas.Top="136" Width="140" Height="10"
                 Fill="{ThemeResource GlassArtShadowBrush}" />

        <!-- Seam light (the Clasp mark's idea): glows out of the opening as the lid lifts.
             Opacity is driven by composition in CaseArtwork.xaml.cs. -->
        <Ellipse x:Name="SeamGlow" Canvas.Left="0" Canvas.Top="18" Width="200" Height="84" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.5,0.55" GradientOrigin="0.5,0.55" RadiusX="0.5" RadiusY="0.5">
                    <GradientStop Offset="0" Color="{ThemeResource GlassHaloColor}" />
                    <GradientStop Offset="1" Color="#00000000" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- Earbuds (heads sit in the gap between body and lid when open). -->
        <Canvas x:Name="Buds" Width="200" Height="150">
            <!-- Stem earbuds (the original drawing). SetBuds switches which child canvas shows. -->
            <Canvas x:Name="StemBuds" Width="200" Height="150">
                <!-- Left bud -->
                <Ellipse Canvas.Left="64" Canvas.Top="40" Width="26" Height="24"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="74" Canvas.Top="47" Width="9" Height="7"
                         Fill="{ThemeResource GlassArtDetailBrush}" />
                <Rectangle Canvas.Left="72" Canvas.Top="58" Width="10" Height="30"
                           RadiusX="5" RadiusY="5"
                           Fill="{ThemeResource GlassArtCaseFillBrush}"
                           Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <!-- Right bud -->
                <Ellipse Canvas.Left="110" Canvas.Top="40" Width="26" Height="24"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="117" Canvas.Top="47" Width="9" Height="7"
                         Fill="{ThemeResource GlassArtDetailBrush}" />
                <Rectangle Canvas.Left="118" Canvas.Top="58" Width="10" Height="30"
                           RadiusX="5" RadiusY="5"
                           Fill="{ThemeResource GlassArtCaseFillBrush}"
                           Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            </Canvas>
            <!-- Pro: rounder heads, a small ear tip toward the middle, stems about half as long. -->
            <Canvas x:Name="ProBuds" Width="200" Height="150" Visibility="Collapsed">
                <Ellipse Canvas.Left="90" Canvas.Top="50" Width="8" Height="14"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="102" Canvas.Top="50" Width="8" Height="14"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="62" Canvas.Top="40" Width="30" Height="28"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="108" Canvas.Top="40" Width="30" Height="28"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="72" Canvas.Top="48" Width="9" Height="7" Fill="{ThemeResource GlassArtDetailBrush}" />
                <Ellipse Canvas.Left="119" Canvas.Top="48" Width="9" Height="7" Fill="{ThemeResource GlassArtDetailBrush}" />
                <Rectangle Canvas.Left="72" Canvas.Top="64" Width="10" Height="16" RadiusX="5" RadiusY="5"
                           Fill="{ThemeResource GlassArtCaseFillBrush}"
                           Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Rectangle Canvas.Left="118" Canvas.Top="64" Width="10" Height="16" RadiusX="5" RadiusY="5"
                           Fill="{ThemeResource GlassArtCaseFillBrush}"
                           Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
            </Canvas>
            <!-- Stemless rounded buds. -->
            <Canvas x:Name="CaseBuds" Width="200" Height="150" Visibility="Collapsed">
                <Ellipse Canvas.Left="60" Canvas.Top="42" Width="32" Height="30"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="108" Canvas.Top="42" Width="32" Height="30"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="71" Canvas.Top="53" Width="10" Height="8" Fill="{ThemeResource GlassArtDetailBrush}" />
                <Ellipse Canvas.Left="119" Canvas.Top="53" Width="10" Height="8" Fill="{ThemeResource GlassArtDetailBrush}" />
            </Canvas>
            <!-- Ear-hook buds: a bud head with a curved hook rising above it (outlined tube: wide stroke, then narrower fill-colour stroke). -->
            <Canvas x:Name="HookBuds" Width="200" Height="150" Visibility="Collapsed">
                <Path Data="M 74,60 C 62,44 72,28 90,30" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{ThemeResource GlassArtCaseStrokeBrush}" />
                <Path Data="M 74,60 C 62,44 72,28 90,30" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{ThemeResource GlassArtCaseFillBrush}" />
                <Path Data="M 126,60 C 138,44 128,28 110,30" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{ThemeResource GlassArtCaseStrokeBrush}" />
                <Path Data="M 126,60 C 138,44 128,28 110,30" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Stroke="{ThemeResource GlassArtCaseFillBrush}" />
                <Ellipse Canvas.Left="66" Canvas.Top="54" Width="26" Height="26"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="108" Canvas.Top="54" Width="26" Height="26"
                         Fill="{ThemeResource GlassArtCaseFillBrush}"
                         Stroke="{ThemeResource GlassArtCaseStrokeBrush}" StrokeThickness="1" />
                <Ellipse Canvas.Left="75" Canvas.Top="62" Width="9" Height="7" Fill="{ThemeResource GlassArtDetailBrush}" />
                <Ellipse Canvas.Left="116" Canvas.Top="62" Width="9" Height="7" Fill="{ThemeResource GlassArtDetailBrush}" />
            </Canvas>
        </Canvas>

        <!-- Case body (bottom part, rounded lower corners). -->
        <Border x:Name="Body"
                Canvas.Left="20" Canvas.Top="64" Width="160" Height="74"
                CornerRadius="6,6,34,34"
                Background="{ThemeResource GlassArtCaseFillBrush}"
                BorderBrush="{ThemeResource GlassArtCaseStrokeBrush}"
                BorderThickness="1" />
        <!-- Status light on the front of the body. -->
        <Ellipse Canvas.Left="97" Canvas.Top="96" Width="6" Height="6"
                 Fill="{ThemeResource GlassArtDetailBrush}" />

        <!-- Lid (top part, rounded upper corners). Hinge = its bottom edge. -->
        <Grid x:Name="Lid" Canvas.Left="20" Canvas.Top="30" Width="160" Height="34">
            <Border x:Name="LidOuter"
                    CornerRadius="34,34,6,6"
                    Background="{ThemeResource GlassArtCaseFillBrush}"
                    BorderBrush="{ThemeResource GlassArtCaseStrokeBrush}"
                    BorderThickness="1" />
            <!-- Underside of the lid, faded in as it swings open. -->
            <Border x:Name="LidInner"
                    Margin="6,4,6,2"
                    CornerRadius="28,28,4,4"
                    Background="{ThemeResource GlassArtLidInnerBrush}" />
        </Grid>
    </Canvas>
</UserControl>

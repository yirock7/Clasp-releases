<?xml version="1.0" encoding="utf-8"?>
<!--
    Single entry point for the Liquid Glass design system, merged by App.xaml after
    XamlControlsResources (so the lightweight-styling keys in GlassTokens win).
    Order matters: tokens first, then the control styles that use them.
    GlassStyles references tokens only through {ThemeResource}, which resolves at run time
    against the application resources, so the two files do not need to merge each other.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Design/GlassTokens.xaml" />
        <ResourceDictionary Source="ms-appx:///Design/GlassStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>
</ResourceDictionary>

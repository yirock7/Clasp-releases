;/*++
; NTPodsAAP.inf
;
; Installs the NTPods AAP L2CAP profile driver as the function driver for the
; Apple Accessory Protocol service the AirPods advertise:
;     BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}
;--*/

[Version]
Signature   = "$WINDOWS NT$"
Class       = Bluetooth
ClassGuid   = {e0cbf06c-cd8b-4647-bb8a-263b43f0f974}
Provider    = %ProviderString%
CatalogFile = NTPodsAAP.cat
DriverVer   = 10/15/2026,1.1.0.0
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
NTPodsAAP.sys = 1,,

[Manufacturer]
%ManufacturerString% = NTPodsAAP,NTamd64.10.0.1..16299

[NTPodsAAP.NTamd64.10.0.1..16299]
%DeviceDesc% = NTPodsAAP_Inst, BTHENUM\{74ec2172-0bad-4d01-8f77-997b2be0722a}

[NTPodsAAP_Inst.NT]
CopyFiles = DriverStore_Dir

[DriverStore_Dir]
NTPodsAAP.sys

[NTPodsAAP_Inst.NT.Services]
AddService = NTPodsAAP,%SPSVCINST_ASSOCSERVICE%, NTPodsAAP_Service_Inst

[NTPodsAAP_Inst.NT.HW]
AddReg = NTPodsAAP_DeviceSecurity

[NTPodsAAP_DeviceSecurity]
; Fail closed. A future explicitly authorized installer may grant the selected
; owner's SID access on the selected devnode without modifying this signed INF.
HKR,,Security,0x00000000,"D:P(A;;GA;;;SY)(A;;GA;;;BA)"

[NTPodsAAP_Service_Inst]
DisplayName   = %ServiceDesc%
ServiceType   = 1              ; SERVICE_KERNEL_DRIVER
StartType     = 3              ; SERVICE_DEMAND_START
ErrorControl  = 1              ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\NTPodsAAP.sys

[NTPodsAAP_Inst.NT.Wdf]
KmdfService = NTPodsAAP, NTPodsAAP_wdfsect

[NTPodsAAP_wdfsect]
KmdfLibraryVersion = 1.15

[Strings]
SPSVCINST_ASSOCSERVICE = 0x00000002
ProviderString     = "NTPods"
ManufacturerString = "NTPods"
DiskId1            = "NTPodsAAP Installation Disk"
DeviceDesc         = "NTPods AAP (AirPods)"
ServiceDesc        = "NTPods AAP L2CAP driver for AirPods"
